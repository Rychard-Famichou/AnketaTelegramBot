[flake8]
max-line-length = 119
# Совместимость с Black (E203 - пробел перед двоеточием)
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .venv,
    venv,
    */migrations/*,
    manage.py

# Специфичные исключения для Django/DRF
per-file-ignores =
    */settings/*.py: E501, F401, F403
    __init__.py: F401
